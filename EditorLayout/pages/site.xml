<?xml version="1.0" encoding="utf-8"?>
<page id="site">
  <section title="建筑配置" kind="form" bind="/5/0" resolve="building">
    <row label="所属势力">
      <field id="flag" field="building.flag" widget="number" />
    </row>
    <row label="建筑ID">
      <field id="type" field="building.type_id" widget="number" lookup="building" />
    </row>
    <row label="雪地贴图 *">
      <field id="extra" field="building.extra" widget="number" />
    </row>
    <row label="贴图变体">
      <field id="owner" field="building.owner" widget="number" />
    </row>
    <row label="横向 / 纵向偏移">
      <field id="dx" field="building.dx" widget="number" />
      <field id="dy" field="building.dy" widget="number" />
    </row>
    <row label="招募朝向 *">
      <field id="field6" field="building.parameter_6" widget="number" />
    </row>
    <actions>
      <action id="add" label="添加建筑" script="place_building" />
      <action id="update" label="保存选中修改" script="apply_building" />
      <action id="delete" label="删除选中建筑" script="delete_event" confirm="确定要删除选中的事件吗？" />
    </actions>
  </section>
  <section title="军事工事配置" kind="form" bind="/5/0" resolve="fort">
    <row label="工事ID">
      <field id="fort_id" field="fort.id" widget="number" lookup="fort" />
    </row>
    <row label="城市名称ID">
      <field id="field1" field="event.parameter_1" widget="number" />
    </row>
    <row label="贴图朝向">
      <field id="field3" field="fort.parameter_3" widget="number" />
    </row>
    <actions>
      <action id="add" label="添加工事" script="place_fort" />
      <action id="update" label="保存选中修改" script="apply_fort" />
      <action id="delete" label="删除选中工事" script="delete_event" confirm="确定要删除选中的事件吗？" />
    </actions>
  </section>
  <section id="event_details" title="地块与地标详情" kind="details" bind="/5/0" model="TriggerEvent" omit="0" labels="../fields/research-labels.json" collapsed="true" resolve="event" prepare="ensure_cell_event" collapsible="true" />
  <section id="province_details" title="全部地标与省份" kind="details" bind="/5" model="TriggerInfo" omit="" labels="../fields/research-labels.json" collapsed="true" collapsible="true" />
</page>
