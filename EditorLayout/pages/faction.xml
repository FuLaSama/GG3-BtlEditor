<?xml version="1.0" encoding="utf-8"?>
<page id="faction">
  <section title="势力" kind="list" bind="/4/0" collapsible="true" collapsed="false">
    <columns>
      <column header="编号" bind="/0.0" />
      <column header="国家" bind="/0.1" />
      <column header="阵营" bind="/0.2" />
    </columns>
    <fields>
      <field id="id" label="战役ID" widget="number" type="u16" bind="/0.0" />
      <field id="country" label="国家ID" widget="number" type="u16" bind="/0.1" />
      <field id="camp" label="阵营" widget="number" type="u8" bind="/0.2" />
      <field id="is_ai" label="玩家控制" widget="number" type="u8" bind="/0.3" tip="0 为电脑，非零为玩家控制。" />
      <field id="val5" label="战败条件" widget="number" type="u8" bind="/0.4" />
      <field id="align1" label="占位1" widget="number" type="u8" bind="/0.5" />
      <field id="gold" label="金币" widget="number" type="u32" bind="/0.6" />
      <field id="tech" label="科技" widget="number" type="u32" bind="/0.7" />
      <field id="income" label="金钱收入倍率" widget="number" type="f32" bind="/0.8" />
      <field id="damage" label="科技收入倍率" widget="number" type="f32" bind="/0.9" />
      <field id="hp" label="部队血率" widget="number" type="f32" bind="/0.10" />
      <field id="r" label="颜色 R" type="u8" bind="/0.11" shift="24" width="8" />
      <field id="g" label="颜色 G" type="u8" bind="/0.11" shift="16" width="8" />
      <field id="b" label="颜色 B" type="u8" bind="/0.11" shift="8" width="8" />
      <field id="a" label="颜色 A" type="u8" bind="/0.11" shift="0" width="8" />
      <field id="align2" label="占位2" widget="number" type="u16" bind="/0.12" />
      <field id="config_id" label="关联地图格" widget="number" type="i16" bind="/0.13" />
      <field id="general_flag" label="集团军科技" widget="number" type="u8" bind="/7" />
      <field id="config_ref" label="国家策略" widget="number" type="u16" bind="/8" />
    </fields>
    <actions>
      <action id="add" label="添加势力" script="add_faction" />
      <action id="update" label="保存选中修改" script="apply_faction" />
      <action id="delete" label="删除选中势力" script="delete_faction" confirm="确定要删除选中的势力吗？" />
      <action id="move_up" label="上移" script="move_faction_up" />
      <action id="move_down" label="下移" script="move_faction_down" />
    </actions>
  </section>
  <section title="部队组" kind="list" bind="/6/1" collapsible="true" collapsed="false">
    <columns>
      <column header="组ID" bind="/0" />
      <column header="成员UID" bind="/1" />
    </columns>
    <fields>
      <field id="flag" label="组ID" widget="number" type="u16" bind="/0" />
      <field id="cells" label="成员UID" widget="integers" bind="/1" />
    </fields>
    <actions>
      <action id="add" label="添加部队组" script="add_route" />
      <action id="update" label="保存部队组" script="set_route" />
      <action id="delete" label="删除部队组" script="delete_route" confirm="确定删除选中的部队组吗？" />
    </actions>
  </section>
  <section id="faction_details" title="势力详细配置" kind="details" bind="/4/0" model="Faction" omit="0,7,8" labels="../fields/research-labels.json" collapsed="true" selection="/4/0" browse="true" collapsible="true" />
</page>
