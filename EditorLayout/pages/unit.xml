<?xml version="1.0" encoding="utf-8"?>
<page id="unit">
  <section kind="form" bind="/6/0" resolve="unit">
    <group title="基础部队信息" id="unit_group_0" collapsible="true" collapsed="false">
      <row label="兵种ID">
        <field id="unit" field="unit.type_id" widget="number" lookup="unit" />
      </row>
      <row label="所属势力 / 单位UID">
        <field id="faction" field="unit.faction" widget="number" />
        <field id="agent" field="unit.agent_id" widget="number" />
      </row>
      <row label="当前 / 最大生命">
        <field id="hp" field="unit.hp" widget="number" />
        <field id="max_hp" field="unit.max_hp" widget="number" />
      </row>
      <row label="编数 / 经验">
        <field id="stack" field="unit.stack" widget="number" />
        <field id="level" field="unit.level" widget="number" />
      </row>
      <row label="关键目标 / 初始士气">
        <field id="play_mode" field="unit.play_mode" widget="number" />
        <field id="ai_target" field="unit.ai_target" widget="number" />
      </row>
      <row label="士气恢复 / 移动力">
        <field id="faction_extra" field="unit.faction_extra" widget="number" />
        <field id="mobility" field="unit.mobility" widget="number" />
      </row>
      <row label="朝向 / 血率">
        <field id="direction" field="unit.direction" widget="number" />
        <field id="val8" field="unit.parameter_8" widget="number" />
      </row>
      <row label="升级进度">
        <field id="val9" field="unit.parameter_9" widget="number" />
      </row>
    </group>
    <group title="部队AI行为" id="unit_group_1" collapsible="true" collapsed="true">
      <row>
        <field id="behavior" field="unit.behavior" label="启用部队行为" widget="check" />
      </row>
      <row label="AI类型">
        <field id="behavior_0" field="unit.behavior.parameter_0" widget="number" when="behavior" />
      </row>
      <row label="积极程度">
        <field id="behavior_id" field="unit.behavior.id" widget="number" when="behavior" />
      </row>
      <row label="目标地图格">
        <field id="behavior_2" field="unit.behavior.parameter_2" widget="number" when="behavior" />
      </row>
      <row label="移动限制">
        <field id="behavior_radius" field="unit.behavior.radius" widget="number" when="behavior" />
      </row>
      <row label="警戒半径">
        <field id="behavior_4" field="unit.behavior.parameter_4" widget="number" when="behavior" />
      </row>
      <row label="目标单位UID">
        <field id="behavior_center" field="unit.behavior.center_cell" widget="number" when="behavior" />
      </row>
      <row label="警戒地图格">
        <field id="behavior_6" field="unit.behavior.parameter_6" widget="number" when="behavior" />
      </row>
    </group>
    <group title="将领配置" id="unit_group_2" collapsible="true" collapsed="true">
      <row>
        <field id="general" field="unit.general" label="启用将领配置" widget="check" />
      </row>
      <row label="将领ID">
        <field id="general_id" field="unit.general.id" widget="number" lookup="general" when="general" />
      </row>
      <row>
        <field id="general_active" field="unit.general.active" label="激活状态 *" widget="check" nullable="true" when="general" />
      </row>
      <row label="晋升等级">
        <field id="general_param2" field="unit.general.parameter_2" widget="number" when="general,general_active" />
      </row>
      <row label="勋章ID">
        <field id="general_medal" when="general" field="unit.general.medal" />
      </row>
    </group>
    <group title="特种部队配置" id="unit_group_3" collapsible="true" collapsed="true">
      <row>
        <field id="ex" field="unit.special" label="启用特种部队配置" widget="check" />
      </row>
      <row label="特种部队ID">
        <field id="ex_id" field="unit.special.id" widget="number" lookup="ex" when="ex" />
      </row>
      <row label="当前 / 最大生命">
        <field id="ex_hp" field="unit.special.hp" widget="number" when="ex" />
        <field id="ex_max_hp" field="unit.special.max_hp" widget="number" when="ex" />
      </row>
      <row label="等级 / 血率">
        <field id="ex_1" field="unit.special.parameter_1" widget="number" when="ex" />
        <field id="ex_4" field="unit.special.parameter_4" widget="number" when="ex" />
      </row>
      <row label="升级标记">
        <field id="ex_5" field="unit.special.parameter_5" widget="number" when="ex" />
      </row>
    </group>
    <actions>
      <action id="add" label="添加部队" script="place_unit" />
      <action id="update" label="保存选中修改" script="apply_unit" />
      <action id="delete" label="删除选中部队" script="delete_unit" confirm="确定要删除选中的部队吗？" />
    </actions>
  </section>
  <section title="地图外部队 / 增援部队" kind="list" bind="/6/0" filter="offmap" collapsible="true" collapsed="false">
    <columns>
      <column header="格子索引" field="unit.cell_index" />
      <column header="部队 ID" field="unit.agent_id" />
      <column header="兵种" field="unit.type_id" />
      <column header="势力" field="unit.faction" />
