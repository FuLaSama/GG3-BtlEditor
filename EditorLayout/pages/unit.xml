    <actions>
      <action id="update" label="保存选中部队" script="apply_unit" />
      <action id="delete" label="删除选中部队" script="delete_unit" confirm="确定删除选中的地图外部队？" />
    </actions>
  </section>
  <section id="unit_details" title="部队详细配置" kind="details" bind="/6/0" model="AIAgent" omit="2,3,5,6,10,11" labels="../fields/research-labels.json" collapsed="true" resolve="unit" collapsible="true" selection="/6/0" />
  <section id="unit_groups" title="部队组与驻军" kind="details" bind="/6" model="AIInfo" omit="0,1" labels="../fields/research-labels.json" collapsed="true" collapsible="true" />
</page>
